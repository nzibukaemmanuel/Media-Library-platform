{
  "info": {
    "name": "Media Library API",
    "description": "Every endpoint of the Media Library API, with example bodies and a test on each request that checks the response format.\n\nSetup: start the API (npm run dev), set the baseUrl variable if it is not http://localhost:3000, then run \"Upload a file\" first. It saves the new item's id in {{mediaId}}, which the other requests use. For upload requests, pick a file in the Body tab.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "mediaId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Media",
      "item": [
        {
          "name": "Upload a file",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "title",
                  "value": "Beach sunset",
                  "type": "text",
                  "description": "Required"
                },
                {
                  "key": "category",
                  "value": "design",
                  "type": "text",
                  "description": "general | marketing | design | documentation | reports | other (default general)"
                },
                {
                  "key": "tags",
                  "value": "summer, beach",
                  "type": "text",
                  "description": "Comma-separated, or repeat the field"
                },
                {
                  "key": "description",
                  "value": "Evening at the coast",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/media",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "media"
              ]
            },
            "description": "Upload one JPEG, PNG or PDF (max 5 MB) with its metadata. Saves the new id in {{mediaId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Uses the standard format', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('success');",
                  "  pm.expect(body).to.have.property('data');",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.id) pm.collectionVariables.set('mediaId', body.data && body.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload several files",
