PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=media_library
DB_USER=postgres
DB_PASSWORD=your_password
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/media_library

# Folder where uploaded media files are stored (and the only place files may be deleted from)
UPLOAD_DIR=uploads

# Database used by "npm test" (created automatically; the name must end in _test)
TEST_DB_NAME=media_library_test
